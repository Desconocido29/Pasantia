<odoo>

    <!-- FORM -->
    <record id="view_animal_form" model="ir.ui.view">
        <field name="name">animal.form</field>
        <field name="model">animal.model</field>
        <field name="arch" type="xml">
            <form string="Animal">

                <header>
                    <button name="animal.report_animal_pdf_action"
                            string="Imprimir PDF"
                            type="action"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="patas"/>
                        <field name="nombre_cliente"/>
                        <field name="raza"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>


    <!-- LIST -->
    <record id="view_animal_list" model="ir.ui.view">
        <field name="name">animal.list</field>
        <field name="model">animal.model</field>
        <field name="arch" type="xml">
            <list string="Animal">
                <field name="name"/>
                <field name="patas"/>
                <field name="nombre_cliente"/>
                <field name="raza"/>
            </list>
        </field>
    </record>


    <!-- SEARCH -->
    <record id="view_animal_search" model="ir.ui.view">
        <field name="name">animal.search</field>
        <field name="model">animal.model</field>
        <field name="arch" type="xml">
            <search string="Buscar Animal">
                <field name="name"/>
                <field name="raza"/>
                <field name="nombre_cliente"/>
                <filter name="mas4patas" string="Más de 4 patas" domain="[('patas','>',4)]"/>
            </search>
        </field>
    </record>


    <!-- KANBAN -->
    <record id="view_animal_kanban" model="ir.ui.view">
        <field name="name">animal.kanban</field>
        <field name="model">animal.model</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong><br/>
                            <span><field name="patas"/> patas</span><br/>
                            <span><field name="nombre_cliente"/></span><br/>
                            <span><field name="raza"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- ACTION -->
    <record id="action_animal" model="ir.actions.act_window">
        <field name="name">Animales</field>
        <field name="res_model">animal.model</field>
        <field name="view_mode">kanban,list,form,search</field>
    </record>


    <!-- MENU -->
    <menuitem id="menu_animal_root" name="Gestión de Animales" sequence="1"/>
    <menuitem id="menu_animal" name="Animales" parent="menu_animal_root" action="action_animal"/>

</odoo>
