<odoo>

    <record id="view_animal_form" model="ir.ui.view">
        <field name="name">kg.animal.form</field>
        <field name="model">kg.animal</field>
        <field name="arch" type="xml">
            <form>
                <field name="name"/>
                <field name="id"/>
            </form>
        </field>
    </record>

    <record id="view_animal_list" model="ir.ui.view">
        <field name="name">kg.animal.list</field>
        <field name="model">kg.animal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="id"/>
            </list>
        </field>
    </record>

    <record id="action_reconcile" model="ir.actions.server">
        <field name="name">Animales</field>
        <field name="model_id" ref="logg.model_kg_animal" />
        <field name="binding_model_id" ref="logg.model_kg_animal" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_hello_world()</field>
    </record>

    <record id="action_animal" model="ir.actions.act_window">
        <field name="name">Animales</field>
        <field name="res_model">kg.animal</field>
        <field name="view_mode">list,form</field>

    </record>

    <menuitem id="model_ejemplo_animal_menu" name="Animales" action="action_animal" sequence="10"/>
    

</odoo>
