<odoo>
    <!-- Vista Formulario -->
    <record id="view_persona_form" model="ir.ui.view">
        <field name="name">persona.form</field>
        <field name="model">persona</field>
        <field name="arch" type="xml">
            <form string="Persona">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Lista -->
    <record id="view_persona_tree" model="ir.ui.view">
        <field name="name">persona.tree</field>
        <field name="model">persona</field>
        <field name="arch" type="xml">
            <list string="Personas">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_persona" model="ir.actions.act_window">
        <field name="name">Personas</field>
        <field name="res_model">persona</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_persona_root" name="Gestión de Personas" sequence="10"/>
    <menuitem id="menu_persona" name="Personas" parent="menu_persona_root"
              action="action_persona" sequence="20"/>
</odoo>
