<odoo>
    <record id="view_product_template_button_inherit" model="ir.ui.view">
        <field name="name">product.template.button.inherit</field>
        <field name="model">product.template</field>
        <!-- hereda la vista base segura -->
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- inserta el botón dentro del formulario -->
            <xpath expr="//sheet" position="inside">
                <button name="Hasta_pronto" string="Hasta pronto" type="object" class="oe_highlight mt16"/>
            </xpath>
        </field>
    </record>
</odoo>
